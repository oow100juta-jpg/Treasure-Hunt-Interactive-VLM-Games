# Safe for browser use. The anon key is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
PARTICIPANT_TOKEN_SECRET=replace-with-at-least-32-random-characters
VISION_PROVIDER=mock
VISION_API_KEY=
VISION_API_URL=
VISION_MODEL=
# Keep false in production unless you intentionally want non-AI demo decisions.
ALLOW_MOCK_VISION_IN_PRODUCTION=false
